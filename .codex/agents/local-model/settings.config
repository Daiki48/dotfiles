# helper専用TOML。親とnative subagentのモデルは変更しない。
model = "gpt-oss:20b"
default_effort = "medium"
max_source_bytes = 8000
max_lines = 160
max_question_bytes = 1600
num_ctx = 16384

[efforts.low]
num_predict = 2048
timeout_seconds = 60

[efforts.medium]
num_predict = 4096
timeout_seconds = 90

[efforts.high]
num_predict = 8192
timeout_seconds = 180
