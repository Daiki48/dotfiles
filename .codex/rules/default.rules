# 通常の作業は workspace-write sandbox と厳格なPreToolUse hookで検査する。
# 検査済みのcommit・単一branch push・通常のIssue/PR管理・low/medium deliveryを無確認で許可する。

prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror", "--tags", "--all"]], decision="forbidden", justification="履歴改変・削除・一括pushは禁止")
prefix_rule(pattern=["git", "commit", "-m"], decision="allow", justification="hook検査済みの通常commit")
prefix_rule(pattern=["git", "push", "-u", "origin"], decision="allow", justification="hook検査済みの単一作業branch push")
prefix_rule(pattern=["git", "-C"], decision="allow", justification="hookがmanaged worktree pathとGit操作を検査", match=["git -C /tmp/managed/task commit -m ':bug: 修正'", "git -C /tmp/managed/task push -u origin HEAD:refs/heads/fix/example"], not_match=["git commit -m ':bug: 修正'"])
prefix_rule(pattern=["env", "-u", "SSH_ASKPASS", "git", "-C"], decision="allow", justification="launcher由来のaskpassを除去し、hookがmanaged worktree pathとGit操作を検査", match=["env -u SSH_ASKPASS git -C /tmp/managed/task commit -m ':bug: 修正'", "env -u SSH_ASKPASS git -C /tmp/managed/task push -u origin HEAD:refs/heads/fix/example"], not_match=["env -u GIT_SSH_COMMAND git -C /tmp/managed/task commit -m ':bug: 修正'"])
prefix_rule(pattern=["gh", "pr", "create", "--draft"], decision="allow", justification="hook検査済みのDraft PR作成")
prefix_rule(pattern=["gh", "issue", ["create", "edit", "comment", "close", "reopen"]], decision="allow", justification="hook検査済みの単一Issue管理")
prefix_rule(pattern=["gh", "pr", ["edit", "comment", "review", "ready", "close", "reopen", "update-branch"]], decision="allow", justification="hook検査済みの単一PR管理")
prefix_rule(pattern=["codex-worktree", "create"], decision="allow", justification="専用helperで検査済みのworktree作成")
prefix_rule(pattern=["codex-worktree", "recover"], decision="allow", justification="中断したmanaged worktreeの検証済み復旧")
prefix_rule(pattern=["codex-delivery", "record-review"], decision="allow", justification="固定head SHAに対するlow/medium review receiptを専用helperで記録")
prefix_rule(pattern=["codex-delivery", "approve-review"], decision="prompt", justification="high/critical riskのdeliveryはDaikiの確認が必要")
prefix_rule(pattern=["codex-delivery", "deliver"], decision="allow", justification="review・CI・Rulesetを再検証する専用helperだけがReady化とmergeを実行")
prefix_rule(pattern=["codex-delivery", "finish"], decision="allow", justification="merge到達性を再検証する専用helperだけがmain同期とmanaged cleanupを実行")
prefix_rule(pattern=["git", ["rebase", "reset", "clean", "restore", "rm", "update-ref"]], decision="forbidden", justification="履歴改変または広範囲な破棄操作は禁止")
prefix_rule(pattern=["git", "worktree", ["add", "remove", "prune", "move", "repair", "lock", "unlock"]], decision="forbidden", justification="worktree lifecycleの書き込みは専用helperに限定する")
prefix_rule(pattern=["git", "checkout", "--"], decision="forbidden", justification="作業中の変更を破棄するcheckoutは禁止")
prefix_rule(pattern=["git", "stash", ["clear", "drop"]], decision="forbidden", justification="stash削除は禁止")
prefix_rule(pattern=["git", "branch", ["-d", "-D", "--delete"]], decision="forbidden", justification="branch削除は禁止")
prefix_rule(pattern=["git", "tag", ["-d", "--delete"]], decision="forbidden", justification="tag削除は禁止")
prefix_rule(pattern=[["rm", "rmdir", "unlink", "shred"]], decision="forbidden", justification="削除操作はDaikiの確認が必要")
